{
  "name": "jobhunt-ai-helper",
  "version": "0.1.0",
  "description": "求职助手 — 本地桌面求职应用（职位/简历/学习/面试）",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "e2e:content-optimize": "node scripts/e2e-run.mjs",
    "e2e:content-optimize:answers": "node scripts/e2e-run.mjs --answers",
    "e2e:content-optimize:promotion": "node scripts/e2e-run.mjs --promotion",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "https://codeload.github.com/WiseLibs/better-sqlite3/tar.gz/refs/tags/v12.12.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "sherpa-onnx-node": "1.13.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.0.0",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "https://codeload.github.com/WiseLibs/better-sqlite3/tar.gz/refs/tags/v12.12.0": true,
    "electron@43.4.0": true
  }
}
